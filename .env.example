# Variables publiques uniquement : aucun secret ici ni sur Vercel (docs/PLAN.md).

# URL absolue du site. Facultative : sur Vercel, on retombe sur VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=

# Lien Cal.com de l'appel, au format utilisateur/evenement. Vide : pas d'agenda, seulement la phrase de secours.
NEXT_PUBLIC_CAL_LINK=

# Supabase : URL du projet et clé publishable (config publique, aussi sur Vercel en Production et Preview).
# En local : `npx supabase status` (API_URL et PUBLISHABLE_KEY du Supabase local). Jamais Supabase Cloud sur le poste.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Mois du prochain démarrage (AAAA-MM). Vide ou passé : la phrase de capacité n'est pas affichée.
NEXT_START_MONTH=

# À ne créer qu'au lancement : la construction échoue alors s'il reste un [NEED].
# SITE_INDEXABLE=true
